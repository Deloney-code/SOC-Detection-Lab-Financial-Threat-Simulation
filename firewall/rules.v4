# Generated by iptables-save
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# Allow loopback
-A INPUT -i lo -j ACCEPT

# Allow established and related connections
-A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT

# Allow SSH
-A INPUT -p tcp --dport 22 -j ACCEPT

# Allow HTTP
-A INPUT -p tcp --dport 80 -j ACCEPT

# Allow HTTPS
-A INPUT -p tcp --dport 443 -j ACCEPT

# Allow Flask banking portal
-A INPUT -p tcp --dport 5000 -j ACCEPT

# Allow ICMP ping
-A INPUT -p icmp -j ACCEPT

# Block SMB from Kali attacker IP
-A INPUT -s 192.168.100.10 -p tcp --dport 445 -j DROP
-A INPUT -s 192.168.100.10 -p udp --dport 445 -j DROP

# Allow SMB from Windows victim only
-A INPUT -s 192.168.100.30 -p tcp --dport 445 -j ACCEPT

COMMIT