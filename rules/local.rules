# Rule 1 — Nmap SYN scan detection
alert tcp any any -> $HOME_NET any (msg:"NMAP SYN Scan Detected"; flags:S; threshold:type threshold,track by_src,count 20,seconds 3; sid:9000001; rev:1;)

# Rule 2 — SSH brute force detection
alert tcp any any -> $HOME_NET 22 (msg:"SSH Brute Force Attempt"; flags:S; threshold:type threshold,track by_src,count 5,seconds 10; sid:9000002; rev:1;)

# Rule 3 — MITM high traffic from Kali
alert tcp 192.168.100.10 any -> any any (msg:"POSSIBLE MITM - High Traffic from Kali"; threshold:type both,track by_src,count 50,seconds 2; sid:9000003; rev:1;)

# Rule 4 — SQL injection on banking portal
alert http 192.168.100.10 any -> $HOME_NET 5000 (msg:"SQL INJECTION ATTEMPT on Banking Portal"; flow:to_server,established; http.request_body; content:"OR"; nocase; sid:9000004; rev:1;)

# Rule 5 — SMB login attempt
alert tcp any any -> $HOME_NET 445 (msg:"SMB LOGIN ATTEMPT DETECTED"; flags:S; sid:9000005; rev:1;)

# Rule 6 — Plaintext credentials
alert http any any -> $HOME_NET 5000 (msg:"PLAINTEXT CREDENTIALS Detected on Banking Portal"; flow:to_server,established; http.request_body; content:"password"; nocase; sid:9000006; rev:1;)

# Rule 7 — Nmap service scan
alert tcp any any -> $HOME_NET any (msg:"NMAP SERVICE SCAN DETECTED"; flags:S; threshold:type both,track by_src,count 15,seconds 2; sid:9000007; rev:1;)